rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /spaces/{sid} {
      // Mọi người có tên trong members (quản trị + chỉ xem) được đọc.
      allow read: if request.auth != null && request.auth.token.email in resource.data.members;
      // Tạo không gian: người tạo phải là quản trị.
      allow create: if request.auth != null
        && request.auth.token.email in request.resource.data.admins
        && request.resource.data.members.hasAll(request.resource.data.admins);
      // Chỉ quản trị được đổi danh sách chia sẻ. Dữ liệu cũ chưa có admins thì coi mọi thành viên là quản trị.
      allow update: if request.auth != null
        && request.auth.token.email in resource.data.get('admins', resource.data.members);
      match /{col}/{doc} {
        allow read: if request.auth != null
          && request.auth.token.email in get(/databases/$(database)/documents/spaces/$(sid)).data.members;
        allow write: if request.auth != null
          && request.auth.token.email in get(/databases/$(database)/documents/spaces/$(sid)).data.get('admins', get(/databases/$(database)/documents/spaces/$(sid)).data.members);
      }
    }
  }
}
